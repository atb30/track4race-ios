{
  "name": "Runner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del corredor"
    },
    "device_id": {
      "type": "string",
      "description": "ID \u00fanico del dispositivo GPS asociado"
    },
    "team_id": {
      "type": "string",
      "description": "ID del equipo al que pertenece"
    },
    "phone_number": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono de contacto"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales sobre el corredor"
    },
    "is_active": {
      "type": "boolean",
      "description": "Si el corredor est\u00e1 activo",
      "default": true
    }
  },
  "required": [
    "name",
    "device_id",
    "team_id"
  ]
}